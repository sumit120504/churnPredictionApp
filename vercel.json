{
  "version": 2,
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index.py"
    },
    {
      "source": "/model-info",
      "destination": "/api/index.py"
    },
    {
      "source": "/customer-examples",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**,data/**",
      "maxDuration": 30
    }
  }
}
